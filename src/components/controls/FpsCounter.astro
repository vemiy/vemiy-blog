---
/**
 * 右下角帧率显示：纯文字，不拦截指针事件，位置固定。
 */
---

<div id="fps" aria-hidden="true"></div>

<style>
	/* 帧率文字固定在右下角，压在浮动控件之下 */
	#fps {
		position: fixed;
		right: 12px;
		bottom: 12px;
		z-index: 999;
		font-size: 12px;
		font-weight: normal;
		color: #aaa;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		backdrop-filter: none;
		box-shadow: none;
		text-shadow: none;
		pointer-events: none;
	}
</style>

<script is:inline>
	(function () {
		if (window.__fpsCounterBooted) return;
		window.__fpsCounterBooted = true;

		var element = document.getElementById("fps");
		if (!element) return;

		var frames = 0;
		var last = Date.now();

		function step() {
			var now = Date.now();
			frames++;
			if (now - last >= 1000) {
				element.textContent = frames + " FPS";
				frames = 0;
				last = now;
			}
			window.requestAnimationFrame(step);
		}

		window.requestAnimationFrame(step);
	})();
</script>
