---
import { Icon } from "astro-icon/components";

/****
 * FloatingButton 组件
 * 用于创建一个悬浮按钮，支持图标、点击事件和可选的辅助标签。
 */

interface Props {
	id: string;
	icon: string;
	/** 可选的第二图标：提供后，按钮加上 .toggled 类时显示此图标、隐藏默认图标 */
	toggleIcon?: string;
	/** 悬停提示文字（原生 tooltip）；缺省时退回 ariaLabel */
	title?: string;
	ariaLabel?: string;
	onclick?: string;
	class?: string;
}

const {
	id,
	icon,
	toggleIcon,
	title,
	ariaLabel,
	onclick,
	class: className = "",
} = Astro.props;
---

<div
  id={id}
  title={title ?? ariaLabel}
  class:list={["floating-btn", className, "card-base flex items-center overflow-hidden transition"]}
  onclick={onclick}
>
  <button
    aria-label={ariaLabel}
    class:list={["h-full w-full", toggleIcon && "has-toggle-icon"]}
  >
    <Icon name={icon} class:list={["mx-auto", toggleIcon && "icon-default"]} />
    {toggleIcon && <Icon name={toggleIcon} class="icon-toggled" />}
  </button>
</div>

<style lang="stylus">
.floating-btn
    color: var(--primary)
    font-size: 1.5rem
    font-weight: bold
    width: 3rem
    height: 3rem
    
    opacity: 1
    cursor: pointer
    pointer-events: auto
    /* 默认状态（显示）：各属性平滑过渡 */
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    border-radius: var(--app-radius-card, 0.25rem)
    background-color: var(--card-bg)
    border: var(--app-card-stroke, 2px solid transparent)
    flex-shrink: 0
    overflow: hidden
    
    /* 图标样式 */
    :global(svg)
        font-size: 1.6rem
        opacity: 1
        transition: opacity 0.2s ease 0.1s /* 显示态图标过渡 */

    /* 双图标切换：两个图标叠放在按钮正中（grid 同格），靠 .toggled 切换显隐 */
    button.has-toggle-icon
        display: grid
        place-items: center

        :global(svg)
            grid-area: 1 / 1

    :global(svg.icon-toggled)
        display: none

    &.toggled
        /* 面板展开时的选中态背景 */
        background-color: var(--btn-regular-bg)

        :global(svg.icon-default)
            display: none
        :global(svg.icon-toggled)
            display: block

        &:hover
            background-color: var(--btn-regular-bg-hover)

    &.hide
        /* 隐藏状态：缩小并收起布局 */
        transform: scale(0.5)
        opacity: 0
        pointer-events: none
        
        /* 强制收缩布局占用 */
        height: 0 !important
        width: 0 !important
        margin: 0 !important
        border-width: 0 !important
        padding: 0 !important
        
        /* 隐藏态图标过渡 */
        /* 隐藏态内部元素过渡 */
        
        :global(svg)
            opacity: 0
            transition: opacity 0.1s ease /* 隐藏态图标过渡 */
        
    &:active
        transform: scale(0.9)
        
    &:hover
        background-color: var(--btn-card-bg-hover)
        color: var(--primary)

/* 暗色主题样式 */
:global(.dark) .floating-btn
    background-color: var(--card-bg)
    color: var(--primary, #60a5fa)

    &:hover
        background-color: var(--btn-card-bg-hover)
        color: var(--primary)

    &.toggled
        background-color: var(--btn-regular-bg)

        &:hover
            background-color: var(--btn-regular-bg-hover)

/* 响应式调整 */
@media (max-width: 768px)
    .floating-btn
        width: 3rem
        height: 3rem
        font-size: 1.5rem
        :global(svg)
            font-size: 1.5rem

@media (max-width: 480px)
    .floating-btn
        width: 2.5rem
        height: 2.5rem
        font-size: 1.25rem
        :global(svg)
            font-size: 1.2rem

@media (max-width: 360px)
    .floating-btn
        width: 2rem
        height: 2rem
        font-size: 1rem
        :global(svg)
            font-size: 1rem

@media (max-width: 320px)
    .floating-btn
        width: 1.75rem
        height: 1.75rem
        font-size: 0.875rem
        :global(svg)
            font-size: 0.875rem

/* 确保按钮始终在可视区域内 */
.floating-btn
    min-width: 0
    min-height: 0
    padding: 0.25rem

    &.hide
        padding: 0

/* 高DPI屏幕优化 */
@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi)
    .floating-btn
        image-rendering: -webkit-optimize-contrast
        image-rendering: crisp-edges
</style>