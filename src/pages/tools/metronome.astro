---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/tools-common.css";

const title = "机械节拍器";
const description = "仿真摆锤节拍器，可调速度与重音。";

// 速度刻度分档，纵坐标按与运行时一致的权重公式分布
const MARKS = [
  40, 42, 44, 46, 48, 50, 52, 54, 56, 58, 60, 63, 66, 69, 72, 76, 80, 84, 88,
  92, 96, 100, 104, 108, 112, 116, 120, 126, 132, 138, 144, 152, 160, 168, 176,
  184, 192, 200, 208,
];
const SCALE_SLOW_Y = 140;
const SCALE_FAST_Y = 460;
const MARK_EXPONENT = 0.705;

// 相邻刻度的中点权重决定间距
const weightAt = (index: number) =>
  ((MARKS[index] + MARKS[index + 1]) / 2) ** MARK_EXPONENT;
const weightSum = MARKS.slice(0, -1).reduce((sum, _bpm, i) => sum + weightAt(i), 0);

const ticks = MARKS.map((bpm, i) => {
  const acc = MARKS.slice(0, i).reduce((sum, _item, k) => sum + weightAt(k), 0);
  return {
    bpm,
    y: SCALE_SLOW_Y + (acc / weightSum) * (SCALE_FAST_Y - SCALE_SLOW_Y),
    left: i % 2 === 0,
  };
});
---

<MainGridLayout title={title} description={description}>
  <header class="vemiy-tool-head-block">
    <h2 class="vemiy-tool-title">{title}</h2>
    <p class="vemiy-tool-desc">{description}</p>
  </header>

  <div class="vemiy-tool vemiy-metronome" id="vemiyMetronome">
    <div class="vemiy-tool-head vemiy-metronome-head">
      <button
        class="vemiy-tool-btn vemiy-tool-btn-primary vemiy-metronome-start"
        id="vemiyMetroStart"
        type="button">开始</button>
      <div class="vemiy-metronome-bell">
        <span class="vemiy-metronome-bell-label">重音</span>
        <input
          class="vemiy-metronome-bell-range"
          type="range"
          id="vemiyMetroBell"
          min="0"
          max="4"
          step="1"
          value="0"
          aria-label="重音间隔"
        />
        <span class="vemiy-metronome-bell-value" id="vemiyMetroBellValue">无</span>
      </div>
    </div>
    <div class="vemiy-metronome-stage">
      <svg
        id="vemiyMetroSvg"
        class="vemiy-metronome-svg"
        width="340"
        height="580"
        viewBox="0 0 340 580"
        role="img"
        aria-label="机械节拍器"
      >
        <path class="vemiy-metronome-body" d="M112 20 L228 20 L300 556 Q300 572 284 572 L56 572 Q40 572 40 556 Z" fill="#2e2e32" stroke="rgba(255,255,255,0.14)" stroke-width="1.5"></path>
        <path class="vemiy-metronome-plate" d="M118 108 L222 108 L284 552 L56 552 Z" fill="#26262a" stroke="rgba(255,255,255,0.06)" stroke-width="1"></path>
        <text class="vemiy-metronome-bpm" id="vemiyMetroBpm" x="170" y="56" text-anchor="middle">120</text>
        <text class="vemiy-metronome-bpm-unit" x="170" y="74" text-anchor="middle">BPM</text>
        <text class="vemiy-metronome-name" id="vemiyMetroName" x="170" y="92" text-anchor="middle">Moderato</text>
        <g class="vemiy-metronome-scale" id="vemiyMetroScale">
          {
            ticks.map((tick) => (
              <>
                <line
                  class="vemiy-metronome-tick"
                  x1={tick.left ? 165 : 175}
                  y1={tick.y.toFixed(1)}
                  x2={tick.left ? 156 : 184}
                  y2={tick.y.toFixed(1)}
                />
                <text
                  class="vemiy-metronome-mark"
                  data-bpm={tick.bpm}
                  x={tick.left ? 136 : 204}
                  y={(tick.y + 3.2).toFixed(1)}
                  text-anchor="middle">{tick.bpm}</text>
              </>
            ))
          }
        </g>
        <g class="vemiy-metronome-pendulum" id="vemiyMetroPendulum">
          <rect class="vemiy-metronome-rod" x="166" y="108" width="8" height="420" rx="3" fill="#d6d6db"></rect>
          <rect class="vemiy-metronome-rod-shade" x="171" y="108" width="3" height="420" rx="1.5" fill="#a8a8ae"></rect>
          <rect class="vemiy-metronome-weight" id="vemiyMetroWeight" x="151" y="248" width="38" height="30" rx="6" fill="#4a4a50" stroke="#131315" stroke-width="1.5"></rect>
          <rect class="vemiy-metronome-weight-top" id="vemiyMetroWeightTop" x="151" y="248" width="38" height="8" rx="4" fill="#63636a"></rect>
          <circle class="vemiy-metronome-grip" id="vemiyMetroGrip" cx="170" cy="263" r="4"></circle>
          <circle class="vemiy-metronome-pivot" cx="170" cy="528" r="5" fill="#b8b8bc"></circle>
        </g>
        <circle class="vemiy-metronome-lamp-glow" id="vemiyMetroLamp" cx="170" cy="528" r="42" fill="color-mix(in srgb, var(--primary) 16%, transparent)"></circle>
        <circle class="vemiy-metronome-lamp" id="vemiyMetroLampDot" cx="170" cy="528" r="6" fill="#3a3a3e"></circle>
      </svg>
    </div>
  </div>
  <script is:inline src="/js/tools/metronome.js"></script>
</MainGridLayout>

<style is:global>
  /* 节拍器专属样式 */
  .vemiy-metronome-head {
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .vemiy-metronome-start {
    min-width: 96px;
    height: 42px;
  }
  .vemiy-metronome-start.is-playing {
    background: #ff7242;
  }
  .vemiy-metronome-bell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.25rem;
    height: 42px;
    border: 1px solid var(--line-color);
    border-radius: 999px;
    background: var(--app-glass-bg);
  }
  .vemiy-metronome-bell-label {
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.8;
    white-space: nowrap;
  }
  .vemiy-metronome-bell-range {
    width: 160px;
    height: 6px;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    border-radius: 999px;
    background: var(--line-color);
    cursor: ew-resize;
  }
  .vemiy-metronome-bell-range::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary);
    border: none;
    cursor: ew-resize;
  }
  .vemiy-metronome-bell-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary);
    border: none;
    cursor: ew-resize;
  }
  .vemiy-metronome-bell-value {
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.9;
    min-width: 2.8rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .vemiy-metronome-stage {
    display: flex;
    justify-content: center;
    border: var(--app-card-stroke);
    border-radius: var(--app-radius-card);
    background: var(--app-glass-bg);
    padding: 1.25rem 1rem;
    margin-bottom: 0.85rem;
  }
  .vemiy-metronome-svg {
    width: 400px;
    max-width: 100%;
    height: auto;
    display: block;
    cursor: grab;
    touch-action: none;
    outline: none;
    overflow: visible;
  }
  .vemiy-metronome-svg:active {
    cursor: grabbing;
  }
  .vemiy-metronome-grip {
    fill: var(--primary);
  }
  .vemiy-metronome-weight {
    cursor: ns-resize;
  }
  .vemiy-metronome-tick {
    stroke: var(--line-color);
    stroke-width: 1;
  }
  .vemiy-metronome-mark {
    fill: var(--content-meta);
    font-size: 9px;
    font-family: Consolas, Monaco, "Courier New", monospace;
    cursor: pointer;
    user-select: none;
  }
  .vemiy-metronome-mark:hover {
    fill: var(--primary);
  }
  .vemiy-metronome-bpm {
    fill: #e9e9ec;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-family: Consolas, Monaco, "Courier New", monospace;
    font-variant-numeric: tabular-nums;
  }
  .vemiy-metronome-bpm-unit {
    fill: var(--content-meta);
    font-size: 8.5px;
    letter-spacing: 0.3em;
    font-family: Consolas, Monaco, "Courier New", monospace;
  }
  .vemiy-metronome-name {
    fill: var(--content-meta);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    font-family: Consolas, Monaco, "Courier New", monospace;
  }
  .vemiy-metronome-lamp-glow {
    opacity: 0;
    transition: opacity 0.1s linear;
    pointer-events: none;
  }
  .vemiy-metronome-lamp-glow.is-on {
    opacity: 1;
  }
  .vemiy-metronome-lamp.is-on {
    fill: var(--primary);
  }
  @media (max-width: 640px) {
    .vemiy-metronome-head {
      flex-wrap: nowrap;
      gap: 0.5rem;
      justify-content: space-between;
    }
    .vemiy-metronome-start {
      width: auto;
      flex: 0 0 auto;
      min-width: 76px;
      height: 38px;
      padding: 0 1rem;
    }
    .vemiy-metronome-bell {
      flex: 1 1 auto;
      min-width: 0;
      height: 38px;
      padding: 0 0.7rem;
      gap: 0.45rem;
    }
    .vemiy-metronome-bell-label {
      font-size: 0.85rem;
    }
    .vemiy-metronome-bell-range {
      width: auto;
      flex: 1 1 auto;
      min-width: 0;
    }
    .vemiy-metronome-bell-value {
      font-size: 0.8rem;
      min-width: 2.4em;
    }
  }
</style>
