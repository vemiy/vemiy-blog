---
import { tools } from "@/data/tools";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/tools-common.css";

const title = "工具";
const description = "在线小工具集合：随机字符串、图片取色、调音器与 IP 纯净度检测。";
---

<MainGridLayout title={title} description={description}>
  <header class="vemiy-tools-head">
    <h2 class="vemiy-tools-title">{title}</h2>
  </header>
  <input
    id="vemiyToolsSearch"
    class="vemiy-tools-search"
    type="text"
    placeholder="搜索工具..."
  />
  <div id="vemiyToolsList" class="vemiy-tools-list">
    {
      tools.map((tool) => (
        <a class="vemiy-tools-item" href={tool.href}>
          <div class="vemiy-tools-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1.1em"
              height="1.1em"
              viewBox="0 0 24 24"
              fill="currentColor"
              set:html={tool.icon}
            />
          </div>
          <div class="vemiy-tools-text">
            <div class="vemiy-tools-name">{tool.name}</div>
            <div class="vemiy-tools-desc">{tool.desc}</div>
          </div>
        </a>
      ))
    }
  </div>
  <div id="vemiyToolsEmpty" class="vemiy-tools-empty">没有匹配的工具。</div>
  <script is:inline src="/js/tools/tools-list.js"></script>
</MainGridLayout>

<style is:global>
  /* 工具列表页样式：各块直接浮在页面底色上，不套外层容器 */
  .vemiy-tools-head {
    margin-bottom: 1rem;
  }
  .vemiy-tools-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .vemiy-tools-subtitle {
    margin-top: 0.3rem;
    font-size: 0.88rem;
    opacity: 0.65;
  }
  .vemiy-tools-search {
    display: block;
    width: 100%;
    border: 2px solid var(--line-color);
    border-radius: var(--app-radius-card);
    background: var(--app-glass-bg);
    color: inherit;
    outline: none;
    transition: 0.2s;
    padding: 0.82rem 1rem;
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
  }
  .vemiy-tools-search:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(73, 177, 245, 0.12);
  }
  .vemiy-tools-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .vemiy-tools-item {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    gap: 0.9rem;
    text-decoration: none !important;
    color: inherit !important;
    padding: 1rem 1.1rem;
    border: 2px solid var(--line-color);
    border-radius: var(--app-radius-card);
    background: var(--app-glass-bg);
    transition: border-color 0.2s ease;
  }
  .vemiy-tools-item:hover {
    color: inherit !important;
    text-decoration: none !important;
    border-color: var(--primary);
  }
  .vemiy-tools-icon {
    width: 22px;
    flex-shrink: 0;
    opacity: 0.92;
    margin-top: 0.02rem;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .vemiy-tools-icon svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
    display: block;
  }
  .vemiy-tools-text {
    min-width: 0;
    flex: 1;
  }
  .vemiy-tools-name {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    margin-bottom: 0.18rem;
  }
  .vemiy-tools-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    opacity: 0.68;
  }
  .vemiy-tools-empty {
    display: none;
    padding: 1rem 0.15rem;
    font-size: 0.9rem;
    opacity: 0.65;
  }
  @media (max-width: 640px) {
    .vemiy-tools-list {
      grid-template-columns: 1fr;
    }
    .vemiy-tools-search {
      font-size: 0.92rem;
      padding: 0.75rem 0.9rem;
    }
    .vemiy-tools-name {
      font-size: 0.96rem;
    }
    .vemiy-tools-desc {
      font-size: 0.84rem;
    }
    .vemiy-tools-item {
      gap: 0.75rem;
    }
    .vemiy-tools-icon {
      width: 20px;
    }
  }
</style>
