---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import "@/styles/home-app.css";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getSortedPosts();
	return paginate(allPosts, { pageSize: siteConfig.pagination.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const len = page.data.length;

/** 顶栏标题：首页为「博客」，后续页附页码 */
const heading =
	page.currentPage === 1 ? "博客" : `博客 · ${page.currentPage}`;
---

<MainGridLayout heading={heading} topbarTitle={heading}>
  <PostPage page={page} />
  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>
