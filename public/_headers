# Cloudflare Workers 静态资源缓存策略
#
# 带内容哈希的资源：文件名随内容变化，可安全长期强缓存。
# 不带哈希的资源：文件名固定，必须每次向服务器校验，否则改版后浏览器仍执行旧代码。

# ── 带哈希：一年强缓存 ─────────────────────────────

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ── 不带哈希：必须校验 ─────────────────────────────

# 页面文档
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# public 目录原样复制的脚本与样式，文件名不含哈希
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/pio/*
  Cache-Control: public, max-age=0, must-revalidate

# 站点元数据
/*.xml
  Cache-Control: public, max-age=0, must-revalidate

/*.txt
  Cache-Control: public, max-age=0, must-revalidate

/*.json
  Cache-Control: public, max-age=0, must-revalidate

# ── 图片与字体：内容稳定，允许较长缓存 ─────────────

/assets/images/*
  Cache-Control: public, max-age=604800

/assets/fonts/*
  Cache-Control: public, max-age=2592000

/assets/music/*
  Cache-Control: public, max-age=604800

/favicon/*
  Cache-Control: public, max-age=604800

/gallery/*
  Cache-Control: public, max-age=604800
